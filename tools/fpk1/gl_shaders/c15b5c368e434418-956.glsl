attribute vec4 vPosition;uniform float aspect;uniform vec4 quad;uniform float rotation;uniform vec4 texRect;varying mediump vec2 texCoord;void main(){vec2 half_size=0.5*quad.zw;vec2 p=vPosition.xy*quad.zw-half_size;float s=sin(rotation),c=cos(rotation);p=vec2(p.x*c-p.y*s,p.y*c+p.x*s)+half_size+quad.xy;texCoord=vec2(vPosition.x,1.0-vPosition.y)*texRect.zw+texRect.xy;gl_Position=vec4(p.x*aspect,p.y,0.0,1.0);}
